local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local Camera = Workspace.CurrentCamera
local CoreGui = game:GetService("CoreGui")

-- Eski kalıntıları temizle
pcall(function()
    for _, v in pairs(CoreGui:GetChildren()) do
        if v.Name:find("Aron") or v.Name:find("Golden") or v.Name:find("Safe") then
            v:Destroy()
        end
    end
end)

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "GoldenAronHub"
ScreenGui.ResetOnSpawn = false
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

pcall(function()
    ScreenGui.Parent = CoreGui
end)
if ScreenGui.Parent ~= CoreGui then
    ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
end

-- Altın Sarısı Tema Renkleri
local Theme = {
    BgDark = Color3.fromRGB(16, 16, 20),
    BgCard = Color3.fromRGB(22, 22, 28),
    Accent = Color3.fromRGB(255, 185, 0), -- Altın Sarısı
    AccentGlow = Color3.fromRGB(255, 170, 0),
    TextWhite = Color3.fromRGB(240, 240, 245),
    TextGray = Color3.fromRGB(140, 140, 155),
}

-- Şık Bildirim Sistemi
local function Notify(text)
    pcall(function()
        local f = Instance.new("Frame", ScreenGui)
        f.Size = UDim2.new(0, 260, 0, 48)
        f.Position = UDim2.new(1, -280, 1, -70)
        f.BackgroundColor3 = Theme.BgCard
        f.BorderSizePixel = 0
        
        local c = Instance.new("UICorner", f)
        c.CornerRadius = UDim.new(0, 8)
        
        local s = Instance.new("UIStroke", f)
        s.Color = Theme.Accent
        s.Transparency = 0.3
        s.Thickness = 1.2
        
        local l = Instance.new("TextLabel", f)
        l.Size = UDim2.new(1, -15, 1, 0)
        l.Position = UDim2.new(0, 15, 0, 0)
        l.BackgroundTransparency = 1
        l.TextColor3 = Theme.TextWhite
        l.TextSize = 12
        l.Font = Enum.Font.GothamMedium
        l.TextXAlignment = Enum.TextXAlignment.Left
        l.Text = text
        
        task.delay(2.8, function() f:Destroy() end)
    end)
end

-- Şifre ekranı kaldırıldı, doğrudan ana panel başlatılıyor
local function LoadHub()
    local Main = Instance.new("Frame", ScreenGui)
    Main.Size = UDim2.new(0, 580, 0, 380)
    Main.Position = UDim2.new(0.5, -290, 0.5, -190)
    Main.BackgroundColor3 = Theme.BgDark
    Main.BorderSizePixel = 0
    Main.Active = true
    Main.Draggable = true

    Instance.new("UICorner", Main).CornerRadius = UDim.new(0, 10)
    local mStroke = Instance.new("UIStroke", Main)
    mStroke.Color = Theme.Accent
    mStroke.Thickness = 1.2

    -- Üst Başlık Barı (Yapımcı İmzalı)
    local Top = Instance.new("Frame", Main)
    Top.Size = UDim2.new(1, 0, 0, 42)
    Top.BackgroundTransparency = 1

    local Logo = Instance.new("TextLabel", Top)
    Logo.Size = UDim2.new(0, 350, 1, 0)
    Logo.Position = UDim2.new(0, 18, 0, 0)
    Logo.BackgroundTransparency = 1
    Logo.TextColor3 = Theme.Accent
    Logo.TextSize = 12
    Logo.Font = Enum.Font.GothamBold
    Logo.TextXAlignment = Enum.TextXAlignment.Left
    Logo.Text = "ARON HUB // LAND OR DIE (Yapımcı: qmiracxws)"

    local Close = Instance.new("TextButton", Top)
    Close.Size = UDim2.new(0, 28, 0, 28)
    Close.Position = UDim2.new(1, -36, 0, 7)
    Close.BackgroundColor3 = Theme.BgCard
    Close.BorderSizePixel = 0
    Close.TextColor3 = Theme.TextWhite
    Close.TextSize = 12
    Close.Font = Enum.Font.GothamBold
    Close.Text = "✕"
    Instance.new("UICorner", Close).CornerRadius = UDim.new(0, 6)
    Close.MouseButton1Click:Connect(function() ScreenGui:Destroy() end)

    local Minimize = Instance.new("TextButton", Top)
    Minimize.Size = UDim2.new(0, 28, 0, 28)
    Minimize.Position = UDim2.new(1, -68, 0, 7)
    Minimize.BackgroundColor3 = Theme.BgCard
    Minimize.BorderSizePixel = 0
    Minimize.TextColor3 = Theme.TextWhite
    Minimize.TextSize = 13
    Minimize.Font = Enum.Font.GothamBold
    Minimize.Text = "-"
    Instance.new("UICorner", Minimize).CornerRadius = UDim.new(0, 6)

    local TabList = Instance.new("ScrollingFrame", Main)
    TabList.Size = UDim2.new(0, 140, 1, -52)
    TabList.Position = UDim2.new(0, 0, 0, 45)
    TabList.BackgroundColor3 = Color3.fromRGB(13, 13, 17)
    TabList.BorderSizePixel = 0
    TabList.CanvasSize = UDim2.new(0, 0, 0, 0)

    local UIList = Instance.new("UIListLayout", TabList)
    UIList.SortOrder = Enum.SortOrder.LayoutOrder
    UIList.Padding = UDim.new(0, 5)

    local UIPad = Instance.new("UIPadding", TabList)
    UIPad.PaddingTop = UDim.new(0, 10)
    UIPad.PaddingLeft = UDim.new(0, 10)
    UIPad.PaddingRight = UDim.new(0, 10)

    local Container = Instance.new("Folder", Main)

    local isOpen = true
    Minimize.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        for _, child in pairs(Main:GetChildren()) do
            if child ~= Top and child ~= mStroke and child:IsA("GuiObject") then
                child.Visible = isOpen
            end
        end
        if isOpen then
            Main.Size = UDim2.new(0, 580, 0, 380)
            Minimize.Text = "-"
        else
            Main.Size = UDim2.new(0, 580, 0, 42)
            Minimize.Text = "+"
        end
    end)

    local function CreateCategory(name)
        local TabBtn = Instance.new("TextButton", TabList)
        TabBtn.Size = UDim2.new(1, 0, 0, 35)
        TabBtn.BackgroundColor3 = Theme.BgCard
        TabBtn.BorderSizePixel = 0
        TabBtn.TextColor3 = Theme.TextGray
        TabBtn.TextSize = 11
        TabBtn.Font = Enum.Font.GothamBold
        TabBtn.Text = name
        Instance.new("UICorner", TabBtn).CornerRadius = UDim.new(0, 6)

        local Page = Instance.new("ScrollingFrame", Container)
        Page.Size = UDim2.new(1, -155, 1, -55)
        Page.Position = UDim2.new(0, 150, 0, 50)
        Page.BackgroundTransparency = 1
        Page.BorderSizePixel = 0
        Page.CanvasSize = UDim2.new(0, 0, 0, 420)
        Page.Visible = false

        local PageLayout = Instance.new("UIListLayout", Page)
        PageLayout.SortOrder = Enum.SortOrder.LayoutOrder
        PageLayout.Padding = UDim.new(0, 8)

        TabBtn.MouseButton1Click:Connect(function()
            for _, p in pairs(Container:GetChildren()) do p.Visible = false end
            for _, b in pairs(TabList:GetChildren()) do
                if b:IsA("TextButton") then
                    b.BackgroundColor3 = Theme.BgCard
                    b.TextColor3 = Theme.TextGray
                end
            end
            Page.Visible = true
            TabBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
            TabBtn.TextColor3 = Theme.Accent
        end)

        return Page
    end

    local Combat = CreateCategory("Combat")
    local Visuals = CreateCategory("Visuals")
    local Player = CreateCategory("Player")
    local Misc = CreateCategory("Misc")

    getgenv().AronConfig = {
        AmmoVal = 100,
        Rapid = false,
        NoRecoil = false,
        ESP = false,
        Aimbot = false,
        Bright = false,
        NoClip = false,
        AntiBan = false,
        AntiKick = false,
    }

    local function AddInput(p, ph, cb)
        local box = Instance.new("TextBox", p)
        box.Size = UDim2.new(1, -10, 0, 36)
        box.BackgroundColor3 = Theme.BgCard
        box.BorderSizePixel = 0
        box.TextColor3 = Theme.TextWhite
        box.PlaceholderText = ph
        box.Text = "100"
        box.TextSize = 11
        box.Font = Enum.Font.Gotham
        Instance.new("UICorner", box).CornerRadius = UDim.new(0, 6)
        box.FocusLost:Connect(function()
            local v = tonumber(box.Text)
            if v then cb(v) end
        end)
    end

    local function AddBtn(p, text, cb)
        local btn = Instance.new("TextButton", p)
        btn.Size = UDim2.new(1, -10, 0, 36)
        btn.BackgroundColor3 = Theme.Accent
        btn.BorderSizePixel = 0
        btn.TextColor3 = Color3.fromRGB(20, 20, 20)
        btn.TextSize = 11
        btn.Font = Enum.Font.GothamBold
        btn.Text = text
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
        btn.MouseButton1Click:Connect(cb)
    end

    local function AddTog(p, text, cb)
        local btn = Instance.new("TextButton", p)
        btn.Size = UDim2.new(1, -10, 0, 36)
        btn.BackgroundColor3 = Theme.BgCard
        btn.BorderSizePixel = 0
        btn.TextColor3 = Theme.TextGray
        btn.TextSize = 11
        btn.Font = Enum.Font.GothamBold
        btn.Text = text .. " : OFF"
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

        local st = false
        btn.MouseButton1Click:Connect(function()
            st = not st
            if st then
                btn.BackgroundColor3 = Theme.Accent
                btn.TextColor3 = Color3.fromRGB(20, 20, 20)
                btn.Text = text .. " : ON"
            else
                btn.BackgroundColor3 = Theme.BgCard
                btn.TextColor3 = Theme.TextGray
                btn.Text = text .. " : OFF"
            end
            cb(st)
        end)
    end

    -- İÇERİKLER
    AddInput(Combat, "Mermi Miktarı", function(v) getgenv().AronConfig.AmmoVal = v end)
    
    AddBtn(Combat, "Give Ammo (Mermi Al)", function()
        pcall(function()
            local char = LocalPlayer.Character
            local success = false
            local amt = tonumber(getgenv().AronConfig.AmmoVal) or 100
            if char then
                for _, t in pairs(char:GetChildren()) do
                    if t:IsA("Tool") then
                        for _, d in pairs(t:GetDescendants()) do
                            if (d:IsA("IntValue") or d:IsA("NumberValue")) and (d.Name:lower():find("ammo") or d.Name:lower():find("clip") or d.Name:lower():find("bullet")) then
                                d.Value = d.Value + amt
                                success = true
                            end
                        end
                    end
                end
            end
            Notify(success and ("+"..amt.." mermi eklendi!") or "Silah bulunamadı!")
        end)
    end)

    AddTog(Combat, "Rapid Fire", function(st)
        getgenv().AronConfig.Rapid = st
        task.spawn(function()
            while getgenv().AronConfig.Rapid do
                pcall(function()
                    local t = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
                    if t then
                        for _, v in pairs(t:GetDescendants()) do
                            if (v:IsA("NumberValue") or v:IsA("IntValue")) and v.Name:lower():find("firerate") then
                                v.Value = 0.01
                            end
                        end
                    end
                end)
                task.wait(0.5)
            end
        end)
    end)

    -- GELİŞMİŞ NO RECOIL
    AddTog(Combat, "No Recoil", function(st)
        getgenv().AronConfig.NoRecoil = st
        task.spawn(function()
            while getgenv().AronConfig.NoRecoil do
                pcall(function()
                    local t = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
                    if t then
                        for _, v in pairs(t:GetDescendants()) do
                            local name = v.Name:lower()
                            if name:find("recoil") or name:find("kick") or name:find("spread") or name:find("shake") or name:find("bloom") or name:find("deviation") then
                                if v:IsA("NumberValue") or v:IsA("IntValue") then
                                    v.Value = 0
                                elseif v:IsA("Vector3Value") then
                                    v.Value = Vector3.new(0, 0, 0)
                                elseif v:IsA("CFrameValue") then
                                    v.Value = CFrame.new()
                                end
                            end
                        end
                    end
                end)
                task.wait(0.1)
            end
        end)
    end)

    -- AKILLİ ESP (Sadece Yaşayanlar)
    AddTog(Visuals, "Zombie ESP", function(st)
        getgenv().AronConfig.ESP = st
        if not st then
            pcall(function()
                for _, v in pairs(Workspace:GetDescendants()) do
                    if v:IsA("Highlight") and v.Name == "AronESP" then v:Destroy() end
                end
            end)
        else
            task.spawn(function()
                while getgenv().AronConfig.ESP do
                    pcall(function()
                        for _, obj in pairs(Workspace:GetDescendants()) do
                            if obj:IsA("Model") then
                                local hum = obj:FindFirstChild("Humanoid")
                                local root = obj:FindFirstChild("HumanoidRootPart")
                                local isPlayer = Players:GetPlayerFromCharacter(obj)
                                local exist = obj:FindFirstChild("AronESP")

                                if exist and (not hum or hum.Health <= 0 or not root) then
                                    exist:Destroy()
                                elseif not isPlayer and hum and hum.Health > 0 and root then
                                    local ln = obj.Name:lower()
                                    if ln:find("zombie") or ln:find("enemy") or ln:find("mob") or ln:find("infected") then
                                        if not exist then
                                            local h = Instance.new("Highlight", obj)
                                            h.Name = "AronESP"
                                            h.FillColor = Theme.Accent
                                            h.OutlineColor = Color3.fromRGB(255, 255, 255)
                                        end
                                    end
                                end
                            end
                        end
                    end)
                    task.wait(0.3)
                end
            end)
        end
    end)

    -- KESİN ÇÖZÜMLÜ AKILLI AIMBOT
    AddTog(Visuals, "Zombie Aimbot", function(st)
        getgenv().AronConfig.Aimbot = st
        local cnn
        if st then
            cnn = RunService.RenderStepped:Connect(function()
                pcall(function()
                    if not getgenv().AronConfig.Aimbot then return end
                    local ch, minDist = nil, math.huge
                    local lRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if not lRoot then return end
                    
                    for _, obj in pairs(Workspace:GetDescendants()) do
                        if obj:IsA("Model") and not Players:GetPlayerFromCharacter(obj) then
                            local hum = obj:FindFirstChild("Humanoid")
                            local head = obj:FindFirstChild("Head")
                            local root = obj:FindFirstChild("HumanoidRootPart")
                            
                            if hum and hum.Health > 0 and head and root then
                                local state = hum:GetState()
                                local isDeadOrDown = (state == Enum.HumanoidStateType.Dead or state == Enum.HumanoidStateType.PlatformStanding)
                                
                                if not isDeadOrDown then
                                    local ln = obj.Name:lower()
                                    if ln:find("zombie") or ln:find("enemy") or ln:find("mob") or ln:find("infected") then
                                        local dist = (lRoot.Position - head.Position).Magnitude
                                        if dist < minDist then
                                            minDist = dist
                                            ch = head
                                        end
                                    end
                                end
                            end
                        end
                    end
                    if ch then Camera.CFrame = CFrame.new(Camera.CFrame.Position, ch.Position) end
                end)
            end)
        else
            if cnn then cnn:Disconnect() end
        end
    end)

    AddTog(Visuals, "Night Vision", function(st)
        getgenv().AronConfig.Bright = st
        pcall(function()
            Lighting.Brightness = st and 2 or 1
            Lighting.ClockTime = st and 14 or 0
            Lighting.GlobalShadows = not st
        end)
    end)

    AddTog(Player, "Noclip", function(st)
        getgenv().AronConfig.NoClip = st
        task.spawn(function()
            while getgenv().AronConfig.NoClip do
                pcall(function()
                    if LocalPlayer.Character then
                        for _, p in pairs(LocalPlayer.Character:GetDescendants()) do
                            if p:IsA("BasePart") then p.CanCollide = false end
                        end
                    end
                end)
                task.wait(0.2)
            end
        end)
    end)

    AddTog(Misc, "Anti-Ban", function(st)
        getgenv().AronConfig.AntiBan = st
        Notify(st and "Anti-Ban aktif edildi." or "Anti-Ban kapatıldı.")
    end)

    AddTog(Misc, "Anti-Kick", function(st)
        getgenv().AronConfig.AntiKick = st
        pcall(function()
            if st and getrawmetatable and setreadonly then
                local mt = getrawmetatable(game)
                setreadonly(mt, false)
                local old = mt.__namecall
                mt.__namecall = newcclosure(function(self, ...)
                    if getnamecallmethod():lower() == "kick" and self == LocalPlayer and getgenv().AronConfig.AntiKick then
                        return
                    end
                    return old(self, ...)
                end)
                setreadonly(mt, true)
            end
        end)
    end)

    AddBtn(Misc, "FPS Boost", function()
        pcall(function()
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
            for _, v in pairs(Workspace:GetDescendants()) do
                if v:IsA("BasePart") then v.Material = Enum.Material.SmoothPlastic
                elseif v:IsA("Decal") or v:IsA("Texture") then v.Transparency = 1 end
            end
            Notify("FPS Boost uygulandı!")
        end)
    end)

    Notify("Aron Hub // Land Or Die v23 Hazır!")
end

-- Doğrudan başlat
LoadHub()
